# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Notebook and Python tool caches
.ipynb_checkpoints/
.pytest_cache/
.mypy_cache/

# Generic result/output files (*.part: incomplete writes of the experiment scripts)
*.part
*.out
*.log
*.tmp
