*.pdb

# Compiler databases and clang tooling artifacts
compile_commands.json
.cache/
.clangd
.clangd/

# Project build output folders
cpp/d/
cpp/f/
cpp/o/
cpp/p/

# Executables/binaries
*.exe
*.x
*.bin
*.run
*.app

# Common no-extension executable names (top-level and project subfolders)
/a.out
*.ex

# vscode settings
.vscode

# Locally-installed Claude Code skills (large vendored asset bundles)
.claude/skills/

# overleaf project
paper/overleaf

DISTRIBUTION_NOTES.md
CLAUDE.md

# Experiment artifacts that are tracked despite the generic rules above: the manifests and
# checksums of the raw data, and the compact results and figures the paper is built from.
# The raw data (raw/*.bin) and build outputs stay untracked; they are regenerable.
experiments/*/raw/smoke/
experiments/*/results/smoke/
!experiments/*/raw/manifest.csv
!experiments/*/raw/checksums.sha256
!experiments/*/raw/raw_checksums.sha256
!experiments/*/checksums.sha256
!experiments/*/*.env.json
!experiments/*/results/*.pdf
!experiments/*/results/*.csv
!experiments/*/results/*.tex
!experiments/*/figures/*.pdf
!experiments/*/figures/*.svg

.DS_Store
.clang-format
