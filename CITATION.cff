    given-names: Keheng
    email: zkeheng@umich.edu
    affiliation: "University of Michigan, Ann Arbor, MI, USA"
  - family-names: Omelchenko
    given-names: Yuri A.
    email: omelche@gmail.com
    affiliation: "Space Science Institute, Boulder, CO, USA"
license: MIT
repository-code: "https://github.com/KehengZhu/bi-kappa-distribution-sampling"
url: "https://kehengzhu.github.io/bi-kappa-distribution-sampling/"
# Concept DOI: always resolves to the newest version.  The version DOI for this
# exact release is added at publication time and is what a reproduction should cite.
doi: 10.5281/zenodo.20617011
version: 2.2.1
keywords:
  - plasma physics
  - kappa distribution
  - bi-Kappa distribution
  - particle-in-cell
  - hybrid simulation
  - velocity distribution function
  - random variate generation
  - Monte Carlo sampling
